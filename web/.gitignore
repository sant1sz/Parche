# Archivos que git ignora en la web (la raíz del monorepo tiene su propio .gitignore).

# dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pruebas
/coverage

# next.js
/.next/
/out/

# producción
/build

# otros
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# archivos de entorno
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
