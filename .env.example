# Copia este archivo como .env y cambia los valores. Nunca subas .env al repositorio.

# PostgreSQL (lo usan docker-compose.yml y el backend)
POSTGRES_DB=parche
POSTGRES_USER=parche
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_PORT=5432

# Backend (Spring Boot)
DB_URL=jdbc:postgresql://localhost:5432/parche
DB_USERNAME=parche
DB_PASSWORD=cambia-esta-contrasena
# "demo" carga los datos de ejemplo de Café La Ceiba (simulados)
SPRING_PROFILES_ACTIVE=demo
SERVER_PORT=8080

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080
