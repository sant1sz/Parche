# Copia este archivo como .env y cambia los valores. Nunca subas .env al repositorio.

# PostgreSQL. Lo usan docker-compose.yml y también el backend, que arma con estas
# variables la URL jdbc:postgresql://localhost:${POSTGRES_PORT}/${POSTGRES_DB}.
POSTGRES_DB=parche
POSTGRES_USER=parche
POSTGRES_PASSWORD=cambia-esta-contrasena
# Puerto del host. Si 5432 ya está ocupado (por ejemplo, por un PostgreSQL instalado), usa otro.
POSTGRES_PORT=5432

# Backend (Spring Boot)
# "demo" carga los datos de ejemplo de Café La Ceiba (simulados)
SPRING_PROFILES_ACTIVE=demo
SERVER_PORT=8080
# Opcionales: para conectarse a otra base en vez de la de Docker Compose. Si están, mandan.
# DB_HOST=localhost
# DB_URL=jdbc:postgresql://servidor:5432/parche
# DB_USERNAME=parche
# DB_PASSWORD=

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080
